{
  "id": "./",
  "name": "BookBoom — My Library",
  "short_name": "BookBoom",
  "description": "Read and study your own PDF books, on any device, offline",
  "lang": "en",
  "dir": "auto",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "orientation": "any",
  "background_color": "#f5f2ec",
  "theme_color": "#1f3a5f",
  "categories": [
    "books",
    "education",
    "productivity"
  ],
  "icons": [
    {
      "src": "static/img/icon-96.png",
      "sizes": "96x96",
      "type": "image/png"
    },
    {
      "src": "static/img/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "static/img/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "static/img/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "static/img/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "static/img/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "screenshots": [
    {
      "src": "static/img/screen-wide.png",
      "sizes": "1366x860",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Your library"
    },
    {
      "src": "static/img/screen-phone.png",
      "sizes": "780x1688",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Reading on a phone"
    }
  ],
  "shortcuts": [
    {
      "name": "Continue reading",
      "short_name": "Continue",
      "url": "./?continue=1",
      "icons": [
        {
          "src": "static/img/icon-96.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Study flashcards",
      "short_name": "Study",
      "url": "./#/study",
      "icons": [
        {
          "src": "static/img/icon-96.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Notes & highlights",
      "short_name": "Notes",
      "url": "./#/notes",
      "icons": [
        {
          "src": "static/img/icon-96.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  "file_handlers": [
    {
      "action": "./?open-file=1",
      "accept": {
        "application/pdf": [
          ".pdf"
        ]
      },
      "launch_type": "multiple-clients"
    }
  ],
  "share_target": {
    "action": "share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "files": [
        {
          "name": "files",
          "accept": [
            "application/pdf",
            ".pdf"
          ]
        }
      ]
    }
  },
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  }
}